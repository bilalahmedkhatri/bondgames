# Server-only app PostgreSQL URL, shared by the app and blog reader.
DATABASE_URL=postgresql://APP_USER:REPLACE_ME@DB_HOST:5432/APP_DATABASE
# Explicit pooler hint; port 6543 / common pooler hostnames are detected too.
BLOG_DATABASE_POOLER=true
# Supabase poolers commonly use require; use verify-full only when a trusted CA is configured.
BLOG_DATABASE_SSL=require
# Exact public B2/CDN origins, comma separated, without paths. Restart after editing.
BLOG_MEDIA_ORIGINS=https://f005.backblazeb2.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
